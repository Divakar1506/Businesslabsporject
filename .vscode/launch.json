{
  // Press F5 in VS Code and pick one of these. Open the "ai-tech-consultant" folder itself (File > Open Folder).
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Task 1: API + Chat screen (start both)",
      "configurations": ["Task 1: Knowledge Brain API (http://localhost:8100/docs)",
                         "Task 1: Chat & expert screen (needs the API running)"],
      "stopAll": true
    },
    {
      "name": "Task 2: Inbox (Knowledge Brain API + review screen)",
      "configurations": ["Task 1: Knowledge Brain API (http://localhost:8100/docs)",
                         "Task 2: Inbox review screen (needs the API running)"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Dashboard: token & cost (real usage)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "dashboard/app.py", "--server.port", "8600", "--server.headless", "false", "--browser.gatherUsageStats", "false"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      "name": "Dashboard: demo data",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "dashboard/app.py", "--server.port", "8601", "--server.headless", "false", "--browser.gatherUsageStats", "false", "--", "--db", "data/demo_usage.db"],
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "preLaunchTask": "Seed demo usage data"
    },
    {
      "name": "Task 1: Knowledge Brain API (http://localhost:8100/docs)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8100"],
      "cwd": "${workspaceFolder}/task1-knowledge-brain",
      "envFile": "${workspaceFolder}/.env",
      "env": {"PYTHONUTF8": "1"}
    },
    {
      "name": "Task 1: Chat & expert screen (needs the API running)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "ui/chat.py", "--server.port", "8501", "--browser.gatherUsageStats", "false"],
      "cwd": "${workspaceFolder}/task1-knowledge-brain",
      "envFile": "${workspaceFolder}/.env",
      "env": {"PYTHONUTF8": "1", "KB_API_URL": "http://localhost:8100"}
    },
    {
      "name": "Task 1: Run evals (offline, $0)",
      "type": "debugpy",
      "request": "launch",
      "program": "evaluation/run_eval.py",
      "cwd": "${workspaceFolder}/task1-knowledge-brain",
      "env": {"PYTHONUTF8": "1", "LLM_MODE": "offline"},
      "console": "integratedTerminal"
    },
    {
      "name": "Task 1: Ingest 20 articles (polite, ~1 min)",
      "type": "debugpy",
      "request": "launch",
      "program": "run_ingest.py",
      "args": ["--limit", "20"],
      "cwd": "${workspaceFolder}/task1-knowledge-brain",
      "env": {"PYTHONUTF8": "1"},
      "console": "integratedTerminal"
    },
    {
      "name": "Task 1: Ingest ALL articles (polite, ~40 min)",
      "type": "debugpy",
      "request": "launch",
      "program": "run_ingest.py",
      "cwd": "${workspaceFolder}/task1-knowledge-brain",
      "env": {"PYTHONUTF8": "1"},
      "console": "integratedTerminal"
    },
    {
      "name": "Task 1: Tests (offline, free)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "cwd": "${workspaceFolder}/task1-knowledge-brain",
      "env": {"PYTHONUTF8": "1", "LLM_MODE": "offline"}
    },
    {
      "name": "Task 2: Inbox review screen (needs the API running)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "ui/review.py", "--server.port", "8502", "--browser.gatherUsageStats", "false"],
      "cwd": "${workspaceFolder}/task2-inbox-agent",
      "envFile": "${workspaceFolder}/.env",
      "env": {"PYTHONUTF8": "1", "KB_API_URL": "http://localhost:8100"}
    },
    {
      "name": "Task 2: Run evals (needs the API running, $0)",
      "type": "debugpy",
      "request": "launch",
      "program": "evaluation/run_eval.py",
      "cwd": "${workspaceFolder}/task2-inbox-agent",
      "env": {"PYTHONUTF8": "1", "LLM_MODE": "offline", "KB_API_URL": "http://localhost:8100"},
      "console": "integratedTerminal"
    },
    {
      "name": "Task 2: Tests (offline, free)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "cwd": "${workspaceFolder}/task2-inbox-agent",
      "env": {"PYTHONUTF8": "1", "LLM_MODE": "offline"}
    },
    {
      "name": "Tests: all (offline, free)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"}
    }
  ]
}
