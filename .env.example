# Copy to .env and fill in. Never commit .env.

# offline (default, $0): replays recorded answers from data/replay.jsonl, else a placeholder
# ollama  ($0): local model via Ollama (run `ollama serve`)
# claude  (paid): real Anthropic API - also needs ANTHROPIC_API_KEY and a cap above 0
LLM_MODE=offline

# Hard limit on paid Claude spend per month, all tasks together. 0 = no paid call can run.
# Only this env var can raise it; the dashboard can set lower limits but never a higher one.
HARD_MONTHLY_CAP_USD=0

ANTHROPIC_API_KEY=
# In claude mode, save every answer to data/replay.jsonl so offline mode can replay it for free.
REPLAY_RECORD=1
REPLAY_FILE=data/replay.jsonl

OLLAMA_MODEL=llama2
OLLAMA_URL=http://localhost:11434

# SQLite file that stores every call (tokens, cost, latency) and the budget settings.
USAGE_DB=data/usage.db
# Claude model used when a task has no model set in the dashboard.
DEFAULT_MODEL=claude-opus-5-5

# Task 1 daily refresh (runs inside the Knowledge Brain API): check the sitemap once a day.
KB_DAILY_REFRESH=1
KB_REFRESH_AT=03:00
